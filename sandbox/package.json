{
  "name": "@stratusagent/plugin-sandbox",
  "version": "0.1.0",
  "description": "Run every agent command under the macOS sandbox: write only the agent's workspace, read only the system and what you list.",
  "type": "module",
  "exports": "./index.js",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/stratuslabs/plugins.git", "directory": "sandbox" },
  "engines": { "node": ">=22.13 <23 || >=23.4" },
  "os": ["darwin"],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@stratusagent/executor-local": "^0.14.0",
    "@stratusagent/plugins": "^0.14.0"
  },
  "stratus": {
    "pluginVersion": 1,
    "contributes": {
      "executors": [{ "name": "sandbox" }]
    }
  }
}
