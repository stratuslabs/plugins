{
  "name": "@stratusagent/plugin-sandbox",
  "version": "0.1.0",
  "description": "Run every agent command under the macOS sandbox: write only the agent's workspace, read only the system and what you list.",
  "type": "module",
  "exports": "./index.js",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "os": ["darwin"],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@stratusagent/executor-local": "^0.11.8",
    "@stratusagent/plugins": "^0.11.8"
  },
  "stratus": {
    "pluginVersion": 1,
    "contributes": {
      "executors": [{ "name": "sandbox" }]
    }
  }
}
