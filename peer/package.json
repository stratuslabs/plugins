{
  "name": "@stratusagent/plugin-peer",
  "version": "0.1.0",
  "description": "peer.delegate: an agent hands a task to an agent on another Stratus daemon and gets its answer back, over signed HTTP.",
  "type": "module",
  "exports": "./index.js",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/stratuslabs/plugins.git", "directory": "peer" },
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "stratus": {
    "pluginVersion": 1,
    "contributes": {
      "channels": [{ "name": "peer" }],
      "tools": [{ "name": "peer.delegate", "risk": "gated" }]
    },
    "config": {
      "type": "object",
      "properties": {
        "self": { "type": "string" },
        "listen": {
          "type": "object",
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "integer", "minimum": 0, "maximum": 65535 }
          },
          "additionalProperties": false
        },
        "peers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": { "url": { "type": "string" } },
            "required": ["url"],
            "additionalProperties": false
          }
        },
        "maxDepth": { "type": "integer", "minimum": 1, "maximum": 100 },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
      },
      "required": ["self"],
      "additionalProperties": false
    }
  }
}
